          }
        ],
        "config": [
          {
            "key": "api_key",
            "label": "VirusTotal API Key",
            "type": "string",
            "secret": true,
            "optional": false
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
